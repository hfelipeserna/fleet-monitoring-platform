{
  "name": "fleet-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "App.tsx",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "bash -c 'args=(\"$@\"); f=(); for a in \"${args[@]}\"; do [[ \"$a\" == \"--run\" ]] || f+=(\"$a\"); done; exec jest \"${f[@]}\"' --",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx || echo \"lint: no eslint config yet\""
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.27.1",
    "@react-native-community/netinfo": "^11.3.1",
    "expo": "~52.0.0",
    "expo-constants": "~17.0.3",
    "expo-location": "~18.0.10",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-get-random-values": "^1.11.0",
    "uuid": "^9.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~18.3.12",
    "@types/uuid": "^10.0.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-preset-expo": "~12.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  }
}
