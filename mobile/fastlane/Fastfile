fastlane_version "2.222.0"

default_platform :android

platform :android do
  desc "Build Android via EAS (preview)"
  lane :build_android do
    sh("npx eas build --platform android --profile preview --non-interactive --no-wait")
  end

  desc "Build Android local gradle (fallback)"
  lane :build_android_local do
    gradle(task: "clean assembleRelease")
  end
end

platform :ios do
  desc "Build iOS via EAS (preview)"
  lane :build_ios do
    sh("npx eas build --platform ios --profile preview --non-interactive --no-wait")
  end

  desc "Build iOS local gym (fallback)"
  lane :build_ios_local do
    gym(scheme: "fleet-mobile")
  end
end

desc "EAS preview both platforms"
lane :build_preview do
  sh("npx eas build --platform all --profile preview --non-interactive --no-wait")
end
