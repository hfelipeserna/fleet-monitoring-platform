# Entorno local — copiar a .env y completar. NUNCA commitear .env real.
# Stack: NATS JetStream, TimescaleDB, backend Go, Genkit/Gemini.

# --- NATS JetStream ---
NATS_URL=nats://localhost:4222
NATS_MAX_PENDING=1024          # PublishAsyncMaxPending para JetStream (backpressure threshold)
JETSTREAM_MAX_BYTES=5368709120 # 5GiB MaxBytes del stream TELEMETRY (env: JETSTREAM_MAX_BYTES)
PUBLISH_TIMEOUT=3s             # timeout por publish async (env: PUBLISH_TIMEOUT, default 3s)
DUPLICATE_WINDOW=2m           # Duplicates window NATS (2m per SPEC FR-003); dedup canónico es DB telemetry_dedup

# --- TimescaleDB ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fleet
POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me-local  # CI default; prod via secrets/env (no hardcode trust auth)

# --- Grafana (observability profile) ---
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me  # requerido en prod; compose usa ${GF_SECURITY_ADMIN_PASSWORD:?required} o :-change-me para CI

# --- Backend HTTP/SSE ---
HTTP_PORT=8080

# --- Agente IA (Genkit) ---
GEMINI_API_KEY=          # obtener en Google AI Studio; nunca commitear
GEMINI_MODEL=gemini-2.5-flash   # clase Flash = free tier ($0); los Pro son pagos
GENKIT_ENV=dev

# --- Guard del harness (opcional) ---
# strict = bloquea ediciones con posibles secretos; warn (default) solo avisa
FMP_SECRET_GUARD=warn
